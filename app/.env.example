# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings → API page. The anon key is safe to embed client-side by
# Supabase's own design — Row Level Security is what actually protects the
# data, not keeping this key secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in. Both are public identifiers that ship inside the binary —
# they're here so an unconfigured checkout hides the Google button instead of
# showing one that fails. From Google Cloud Console → Credentials:
#   IOS_CLIENT_ID  — the OAuth client of type iOS
#   WEB_CLIENT_ID  — the OAuth client of type Web. Needed even though the app
#                    is iOS-only: it's the audience Supabase validates against.
# Leave both blank to build without Google sign-in.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
